# Semua OPSIONAL. Token bot, API key, dan pengaturan lain diisi lewat halaman /admin.

# Alamat rahasia halaman admin, misal ADMIN_PATH=k7x-panel-93qz lalu buka /k7x-panel-93qz.
# Kalau diisi, /admin menampilkan 404. Kalau kosong, alamatnya tetap /admin.
ADMIN_PATH=

# Kode sekali pakai agar hanya kamu yang bisa membuat password admin pertama kali.
SETUP_CODE=

# Kunci enkripsi untuk token/API key. Kalau kosong, dibuat otomatis dan disimpan di database.
APP_SECRET=

# Terisi otomatis kalau Upstash Redis dipasang lewat Vercel Marketplace:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (atau KV_REST_API_URL / KV_REST_API_TOKEN)
